# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Required: Generate a secure random key for JWT signing
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Database URL - SQLite for dev, PostgreSQL for production
# SQLite (default): sqlite:///./backend/diary.db
# PostgreSQL: postgresql://user:password@host:5432/diary
DATABASE_URL=sqlite:///./backend/diary.db

# Optional: CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: Rate limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# Optional: Email settings (for future email verification)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@mydiary.app